<script setup lang="ts">
import { onMounted, ref } from 'vue'
import { ElMessage, ElMessageBox } from 'element-plus'
import {
  list${className},
  add${className},
  delete${className}ByCondition,
  type ${className}
} from '@/api/${className}'

const loading = ref(false)
const rows = ref<${className}[]>([])
const query = ref<Partial<${className}>>({})
const dialogVisible = ref(false)
const form = ref<Partial<${className}>>({})
const saving = ref(false)

async function load() {
  loading.value = true
  try {
    const res = await list${className}(query.value)
    rows.value = res
  } finally {
    loading.value = false
  }
}

function handleAdd() {
  form.value = {}
  dialogVisible.value = true
}

async function handleSave() {
  saving.value = true
  try {
    await add${className}(form.value)
    ElMessage.success('新增成功')
    dialogVisible.value = false
    await load()
  } finally {
    saving.value = false
  }
}

#if($primaryKeys.size() == 2)
async function handleDelete(row: ${className}) {
  await ElMessageBox.confirm('确认删除该关联记录？', '警告', { type: 'warning' })
  // 复合主键删除：以其中一个键为条件删除（如清空某用户/某角色的关联）
  const condition: Partial<${className}> = {}
  condition[$primaryKeys.get(0).fieldName] = row.$primaryKeys.get(0).fieldName
  condition[$primaryKeys.get(1).fieldName] = row.$primaryKeys.get(1).fieldName
  await delete${className}ByCondition(condition)
  ElMessage.success('删除成功')
  await load()
}
#else
async function handleDelete(row: ${className}) {
  await ElMessageBox.confirm('确认删除该记录？', '警告', { type: 'warning' })
  await delete${className}ByCondition({ ...row })
