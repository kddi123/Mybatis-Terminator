<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hr.system.mapper.SysUserRoleMapper">

    <resultMap id="BaseResultMap" type="com.hr.system.entity.SysUserRole">
        <result property="userId" column="user_id"/>
        <result property="roleId" column="role_id"/>
    </resultMap>

    <sql id="BaseColumns">
user_id,
role_id
    </sql>

    <!-- 复合主键 where 片段 -->
    <sql id="KeyWhere">
        where user_id = #{key.userId,jdbcType=BIGINT} and role_id = #{key.roleId,jdbcType=BIGINT}
    </sql>

    <select id="selectList" parameterType="com.hr.system.entity.SysUserRole" resultMap="BaseResultMap">
        select <include refid="BaseColumns"/> from sys_user_role
        <where>
            <if test="userId != null">
                and user_id = #{userId,jdbcType=BIGINT}
            </if>
            <if test="roleId != null">
                and role_id = #{roleId,jdbcType=BIGINT}
            </if>
        </where>
        order by user_id, role_id
    </select>

    <select id="selectByKey" resultMap="BaseResultMap">
        select <include refid="BaseColumns"/> from sys_user_role
        <include refid="KeyWhere"/>
    </select>

    <insert id="insert" parameterType="com.hr.system.entity.SysUserRole">
        insert into sys_user_role
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="roleId != null">role_id,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId,jdbcType=BIGINT},</if>
            <if test="roleId != null">#{roleId,jdbcType=BIGINT},</if>
        </trim>
    </insert>

    <delete id="deleteByKey" parameterType="com.hr.system.entity.SysUserRole">
        delete from sys_user_role
        <include refid="KeyWhere"/>
    </delete>

    <delete id="deleteByCondition" parameterType="com.hr.system.entity.SysUserRole">
        delete from sys_user_role
        <where>
            <if test="userId != null">
                and user_id = #{userId,jdbcType=BIGINT}
            </if>
            <if test="roleId != null">
                and role_id = #{roleId,jdbcType=BIGINT}
            </if>
        </where>
    </delete>
</mapper>
