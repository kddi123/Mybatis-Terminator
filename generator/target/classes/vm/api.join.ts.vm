import { get, post, del } from '@/utils/request'

/** $comment（关联表，字段类型与数据库表 $tableName 一一对照） */
export interface $className {
#foreach($column in $columns)
  /** $column.comment（$column.fullType → $column.tsType） */
  $column.fieldName?: $column.tsType
#end
}

/** 查询$comment列表 */
export function list${className}(params: Partial<${className}>) {
  return get<${className}[]>(`/$module/$businessName/list`, { params })
}

/** 按复合主键查询详情 */
export function get${className}ByKey(key: Partial<${className}>) {
  return post<${className}>(`/$module/$businessName/key`, key)
}

/** 新增关联 */
export function add${className}(data: Partial<${className}>) {
  return post<void>(`/$module/$businessName`, data)
}

/** 按复合主键删除关联 */
export function delete${className}ByKey(key: Partial<${className}>) {
  return del<void>(`/$module/$businessName/key`, { data: key })
}

/** 按条件批量删除关联（如清空某用户全部角色） */
export function delete${className}ByCondition(condition: Partial<${className}>) {
  return del<void>(`/$module/$businessName/condition`, { data: condition })
}
